
#include <iostream>
#include <string>
using namespace std;

class Book {
    string title, author;
    int copies;

public:
    Book() : Book("", "", 0) {}

    Book(string t, string a, int c)
        : title(t), author(a), copies(c >= 0 ? c : 0) {}

    explicit Book(string t) : Book(t, "Unknown", 1) {}

    void display() {
        cout << title << " by " << author
             << " (" << copies << " copies)" << endl;
    }
};

int main() {
    Book b1;
    Book b2("C++ Primer", "Lippman", 5);
    Book b3("Donated Novel");

    b1.display();
    b2.display();
    b3.display();

    return 0;
}
