
#include <iostream>
#include <string>
using namespace std;

class Person {
public:
    string name;
    int id;
    string phone;

    Person(string n, int i, string p)
        : name(n), id(i), phone(p) {}
};

class Student : virtual public Person {
public:
    string programme;
    float cgpa;

    Student(string n, int i, string p, string pr, float c)
        : Person(n, i, p), programme(pr), cgpa(c) {}
};

class Staff : virtual public Person {
public:
    string department;
    double salary;

    Staff(string n, int i, string p, string d, double s)
        : Person(n, i, p), department(d), salary(s) {}
};

class TeachingAssistant : public Student, public Staff {
public:
    TeachingAssistant(string n, int i, string p)
        : Person(n, i, p),
          Student(n, i, p, "CSE", 8.5),
          Staff(n, i, p, "IT", 30000) {}
};

class ResearchScholar : public Student {
public:
    double fellowship;

    ResearchScholar(string n, int i, string p, double f)
        : Person(n, i, p),
          Student(n, i, p, "Research", 9.0),
          fellowship(f) {}
};

int main() {
    TeachingAssistant t("Mathan", 101, "9876543210");

    cout << t.name << endl;
    cout << t.programme << endl;
    cout << t.department << endl;

    ResearchScholar r("Vijay", 102, "9876543211", 15000);

    cout << r.name << endl;
    cout << r.fellowship << endl;

    return 0;
}
