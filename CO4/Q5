
#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

class Cart {
    string items[10];
    double prices[10];
    int n = 0;
    double discount = 0;

public:
    Cart& add(string item, double price) {
        if (n < 10) {
            items[n] = item;
            prices[n] = price;
            n++;
        }
        return *this;
    }

    Cart& setDiscount(double discount) {
        this->discount = discount;
        return *this;
    }

    double total() const {
        double t = 0;

        for (int i = 0; i < n; i++)
            t += prices[i];

        return t * (100 - discount) / 100;
    }
};

int main() {
    Cart c;

    c.add("Rice", 60)
     .add("Dal", 120)
     .setDiscount(10);

    Cart* p = &c;
    p->add("Oil", 180);

    cout << fixed << setprecision(2);
    cout << p->total() << endl;

    Cart& r = c;
    cout << r.total() << endl;

    Cart* h = new Cart();
    h->add("Milk", 50);
    cout << h->total() << endl;
    delete h;

    Cart* arr[3];

    Cart a, b, d;

    a.add("Book", 100);
    b.add("Pen", 50);
    d.add("Bag", 500);

    arr[0] = &a;
    arr[1] = &b;
    arr[2] = &d;

    Cart* highest = arr[0];

    for (int i = 1; i < 3; i++) {
        if (arr[i]->total() > highest->total())
            highest = arr[i];
    }

    cout << "Highest: " << highest->total();

    return 0;
}
