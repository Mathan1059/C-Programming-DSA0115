
#include <iostream>
using namespace std;

class SavingsAccount {
    long long accNo, balance;
    static const int MAX_TX = 10;
    long long tx[MAX_TX];
    int count, head;

public:
    SavingsAccount(long long no, long long bal = 0) {
        accNo = no;
        balance = bal;
        count = 0;
        head = 0;
    }

    void deposit(long long amount) {
        if (amount <= 0) return;
        balance += amount;

        if (count == MAX_TX)
            head = (head + 1) % MAX_TX;
        else
            count++;

        tx[(head + count - 1) % MAX_TX] = amount;
    }

    bool withdraw(long long amount) {
        if (amount <= 0 || amount > balance)
            return false;

        balance -= amount;

        if (count == MAX_TX)
            head = (head + 1) % MAX_TX;
        else
            count++;

        tx[(head + count - 1) % MAX_TX] = -amount;
        return true;
    }

    void miniStatement() const {
        cout << "Account: " << accNo << endl;
        cout << "Balance: " << balance << endl;

        for (int i = 0; i < count; i++) {
            int idx = (head + i) % MAX_TX;
            cout << tx[idx] << endl;
        }
    }
};

int main() {
    SavingsAccount a(101, 50000);

    a.deposit(10000);
    a.withdraw(5000);
    a.miniStatement();

    return 0;
}
