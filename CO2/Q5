
#include <iostream>
using namespace std;

class BusTicket {
    static int issued;
    static const int CAPACITY = 3;
    int seat;
    string name;

public:
    BusTicket(string n) {
        name = n;
        seat = 0;

        if (issued < CAPACITY) {
            ++issued;
            seat = issued;
        }
    }

    static int count() {
        return issued;
    }

    void print() {
        cout << name << ": ";

        if (seat == 0)
            cout << "Waiting";
        else
            cout << "Seat " << seat;

        cout << endl;
    }
};

int BusTicket::issued = 0;

int main() {
    BusTicket b[] = {
        BusTicket("Asha"),
        BusTicket("Bala"),
        BusTicket("Chitra"),
        BusTicket("Dev")
    };

    for (int i = 0; i < 4; i++)
        b[i].print();

    cout << "Issued: " << BusTicket::count();

    return 0;
}
